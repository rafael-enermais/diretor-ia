# MODELO. Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets (Streamlit Cloud).
# Os valores reais NUNCA vao para o GitHub (secrets.toml esta no .gitignore).
DATABASE_URL = "postgresql://USUARIO:SENHA@HOST:PORTA/postgres"   # pooler; usuario = app_diretoria.<ref-do-projeto>
SUPABASE_URL = "https://<ref-do-projeto>.supabase.co"
SUPABASE_ANON_KEY = "<chave anon/public; nunca a chave de servico>"
# Fase 2 (chat), ainda nao usadas:
# ANTHROPIC_API_KEY = "..."
# ANTHROPIC_MODEL = "claude-sonnet-5"
